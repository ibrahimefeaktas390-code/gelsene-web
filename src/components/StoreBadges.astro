---
// Uygulama henüz mağazalarda değil: bilerek bağlantı yok. Yayına çıkınca <a> ile değiştir.
const stores = [
  { name: 'App Store', platform: 'iPhone için' },
  { name: 'Google Play', platform: 'Android için' },
];
---

<ul class="stores" aria-label="Uygulama mağazaları">
  {
    stores.map((store) => (
      <li class="store">
        <span class="store-platform">{store.platform}</span>
        <span class="store-name">{store.name}</span>
        <span class="store-soon">Yakında</span>
      </li>
    ))
  }
</ul>

<style>
  .stores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .store {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 14px;
    min-width: 200px;
    padding: 10px 16px;
    border-radius: 14px;
    border: 2px dashed var(--border);
    background: var(--surface);
  }

  .store-platform {
    grid-column: 1;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.2;
  }

  .store-name {
    grid-column: 1;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .store-soon {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    background: var(--surface-2);
    color: var(--brand-ink);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: 999px;
  }
</style>
