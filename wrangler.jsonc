{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gelsene-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Astro'nun statik çıktısı. /a/* dışındaki her istek doğrudan buradan servis edilir.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/a/*"]
  },
  // Herkese açık değerler (uygulamada da EXPO_PUBLIC_ olarak gömülü). anon/publishable anahtar;
  // service_role anahtarı buraya ASLA yazılmaz.
